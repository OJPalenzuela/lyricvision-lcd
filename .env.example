# LyricVision LCD — example environment variables
# Copy to `.env` and fill in your own values. Never commit `.env`.

# Spotify application client ID (from https://developer.spotify.com/dashboard).
# The shell asks for this in the UI; this variable documents the value needed for local dev.
SPOTIFY_CLIENT_ID=your-client-id-here

# Optional OAuth callback port. The shell listens on 127.0.0.1 and walks
# the fallback chain 17321-17331 when the first port is busy.
# See docs/shell-notes.md for the manual GUI verification steps.
# SPOTIFY_REDIRECT_PORT=17321
