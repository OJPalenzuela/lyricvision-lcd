{
  "name": "lyricvision-lcd",
  "version": "0.1.0",
  "description": "Spotify synced-lyrics display for Thermalright USB LCD panels (Vision MAX / Vision 360). Windows-only v0.1.",
  "license": "Apache-2.0",
  "keywords": [
    "spotify",
    "lyrics",
    "synced-lyrics",
    "lcd",
    "usb-lcd",
    "thermalright",
    "vision-max",
    "electron",
    "python",
    "windows",
    "lrclib"
  ],
  "main": "src/main.js",
  "packageManager": "pnpm@12.5.1",
  "//electron": "Electron 44.4.3 = latest stable published on the npm registry at scaffold time (2026-09-20).",
  "//signing": "v0.1 ships UNSIGNED (no code signing yet). This blocks public release, not local dev/packaging.",
  "//publish": "CI release workflow (.github/workflows/release.yml) publishes on v* tags: unsigned Setup.exe + checksums.txt, notes from docs/release-notes-<tag>.md. Signing not wired yet.",
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "start": "pnpm run build && electron .",
    "verify:spawn": "node tests/test_shell_spawn.js",
    "test": "vitest run",
    "test:integration": "node tests/test_shell_spawn.js",
    "test:py": ".venv\\Scripts\\python.exe -m pytest tests -q",
    "test:all": "pnpm test && pnpm test:py",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "com.lyricvision.app",
    "productName": "LyricVision LCD",
    "files": [
      "src/*.js",
      "dist/renderer/**/*",
      "bridge/**/*",
      "panels/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "extraResources": [
      {
        "from": "resources/lcd_bridge.exe",
        "to": "lcd_bridge.exe"
      }
    ],
    "publish": [
      {
        "provider": "github"
      }
    ]
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "jsdom": "30.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "konva": "^10.6.0",
    "lucide-react": "^1.47.0",
    "motion": "^13.4.0",
    "react": "^19.3.0",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.0",
    "react-konva": "^19.3.0",
    "tailwind-merge": "^3.7.0",
    "use-image": "^1.1.4",
    "zod": "^4.6.5",
    "zundo": "^2.3.0",
    "zustand": "^5.0.15"
  }
}
